[Unit]
Description=Usage Bar read-only host metrics
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/usage-bar/metrics.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
StateDirectory=usage-bar
ReadWritePaths=%S/usage-bar
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
